1.QUESTION:Display employee name and salary. Use CASE to show:
Salary >= 50000 → 'High'
Salary < 50000 → 'Low'

select name,salary,
case
when salary>=50000 then'High'
when salary <50000 then 'Low'
end as temperature 
from employees;
