show columns from employee;
select MOD(sal,3)AS  emp; 



select deptno,AVG(sal) as avg_salary from  emp GROUP BY deptno;
Select ename, COUNT(*) AS count_name FROM emp GROUP BY ename HAVING COUNT(*) > 1;
desc emp;
select year (hiredate) AS hire_year, COUNT(*) AS  employee_count
from emp 
GROUP BY year (hiredate) 
ORDER BY hire_year;

select mgr, COUNT(*) AS no_of_employees FROM emp GROUP BY mgr;
select job,avg (sal) AS avg_salary from emp GROUP BY job HAVING avg (sal) > 1500;
select deptno from emp where comm IS NOT NULL GROUP BY deptno;
select mgr,COUNT(*) AS no_of_employees FROM emp GROUP BY mgr HAVING COUNT(*) >2;
