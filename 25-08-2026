Q1. Display name, salary, and row number based on salary ascending, and name alphabetically when salaries are equal.
select name,salary,
row_number() over(order by salary asc,name asc) as salaries 
from employees;
----------------------------------------------------------------------------------------------------------------------------------------

Q2. Display name, salary, and row number based on salary descending, and employee_id ascending when salaries are equal.
select  name,salary,
row_number() over(order by salary desc,name desc)as total_salary
from employees;
-------------------------------------------------------------------------------------------------------------------------------------------------
Q3. Display all employee columns and add a row_num column using ROW_NUMBER() based on name alphabetically.
select *,
row_number() over(order by name asc) as row_num
from employees;
---------------------------------------------------------------------------------------------------------------------------------
Q4. Display name, salary, and row number based on salary DESC and name ASC.
