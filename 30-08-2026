rank() over(partition by department_id order by salary  desc) as row_num from employees
order by department_id,rank_num;
Q15. Display: name | department_id | salary | row_num | rank_num | dense_rank_num
using all three:
ROW_NUMBER()
RANK()
DENSE_RANK()


SELECT name, department_id, salary,

ROW_NUMBER() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
) AS row_num,

RANK() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
) AS rank_num,

DENSE_RANK() OVER (
    PARTITION BY department_id
    ORDER BY salary DESC
) AS dense_rank_num

FROM employees;
