2.QUESTION: Display employees whose salary is greater than 50,000
select * from employees where salary >50000
--------------------------------------------------------------------------------------------------
3.QUESTION: Display employees from Bangalore.
select * from employee where city='Bangalore
---------------------------------------------------------------------------------------------------
4.QUESTION: Display employees order by salary from lowest to higest.
select * from employees order by salary DESC
-----------------------------------------------------------------------------------------------------
5.QUESTION: Display the top 5 highest-paid employees.
select * from employee order by salary DESC limit 5;
-----------------------------------------------------------------------------------------------------
6.QUESTION: Display the 3 lowest-paid employees
select * from employee order by Salary ASC limit 3;
-----------------------------------------------------------------------------------------------------
7.QUESTION: Display employees order by name and (A-Z)
select * from employees order by name  ASC;
----------------------------------------------------------------------------------------------------
8.QUESTION:Display employee order by age from oldest to youngest
